# Backend API origin used by Roamenu.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Auth origin. Keep this equal to the local API origin for local auth.
EXPO_PUBLIC_AUTH_URL=http://localhost:3000
# Development-only local sign-in. Keep disabled for preview/production.
EXPO_PUBLIC_MOCK_AUTH=0
EXPO_PUBLIC_MOCK_USER_NAME=Local User
