# Backend API origin used by Roamenu.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Public website origin used for shared-menu handoff links. Local testing can use localhost.
EXPO_PUBLIC_PUBLIC_SITE_URL=http://localhost:3001
# Development-only local sign-in. Keep disabled for preview/production.
EXPO_PUBLIC_MOCK_AUTH=0
EXPO_PUBLIC_MOCK_USER_NAME=Local User
NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/...
NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=...
# Optional web-only OAuth callback. Keep native builds on their platform-native redirect.
EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=http://localhost:8082
