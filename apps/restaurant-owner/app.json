    "android": {
      "package": "com.roamenu.restaurantowner",
      "adaptiveIcon": {
        "foregroundImage": "../../assets/icon.png",
        "backgroundColor": "#FFF4D6"
      }
    },
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro"
    }
  }
}
