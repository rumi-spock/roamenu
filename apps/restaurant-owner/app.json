{
  "expo": {
    "name": "Roamenu for Restaurants",
    "slug": "roamenu-restaurant-owner",
    "version": "0.1.0",
    "icon": "../../assets/icon.png",
    "orientation": "portrait",
    "scheme": "roamenu-owner",
    "ios": {
      "bundleIdentifier": "com.roamenu.restaurantowner",
      "infoPlist": {
