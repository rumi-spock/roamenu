{
  "expo": {
    "name": "Roamenu",
    "slug": "roamenu",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": [
      "roamenu",
      "com.googleusercontent.apps.1023228353106-sria3devqhvji34f9lfl0l763to43rua",
      "com.googleusercontent.apps.1023228353106-0fdhk27danbq0b324a7kn3ktk1585n2u"
    ],
    "ios": {
      "bundleIdentifier": "com.roamenu.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.roamenu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFF4D6"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Roamenu to choose menu photos.",
          "cameraPermission": "Allow Roamenu to take menu photos."
        }
      ],
      "expo-web-browser"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "4a4396fd-89fb-4526-ad50-035d6d9dc365"
      }
    }
  }
}
